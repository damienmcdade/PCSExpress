{
  "appId": "com.pcsexpress.app",
  "appName": "PCS Express",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "contentInsetAdjustmentBehavior": "never",
    "scrollEnabled": true,
    "zoomEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0
    }
  },
  "packageClassList": [
    "HapticsPlugin",
    "PCSProPlugin"
  ],
  "android": {
    "zoomEnabled": true
  }
}
